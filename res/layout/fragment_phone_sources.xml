<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/nova_space_s">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            tools:targetApi="28"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="@string/phone_sources_title"
            android:textAppearance="@style/NovaPhone.Text.ScreenTitle" />

        <ImageButton
            android:id="@+id/sources_add"
            android:layout_width="@dimen/nova_touch_target"
            android:layout_height="@dimen/nova_touch_target"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_add_source"
            android:src="@drawable/ic_phone_add"
            app:tint="@color/nova_text" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sources_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nova_divider" />

    <FrameLayout
        android:id="@+id/sources_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
