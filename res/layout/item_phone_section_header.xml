<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/nova_gutter"
    android:paddingTop="@dimen/nova_space_m"
    android:paddingEnd="@dimen/nova_gutter"
    android:paddingBottom="@dimen/nova_space_xs">

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        tools:targetApi="28"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/NovaPhone.Text.SectionHeader" />

    <TextView
        android:id="@+id/header_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nova_space_s"
        android:textAppearance="@style/NovaPhone.Text.ItemMeta" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/header_action"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nova_space_s"
        android:minHeight="@dimen/nova_touch_target"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
