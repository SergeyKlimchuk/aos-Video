<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        app:tint="@color/nova_text_secondary" />

    <TextView
        android:id="@+id/empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_space_l"
        android:gravity="center"
        android:textAppearance="@style/NovaPhone.Text.Body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_space_s"
        android:gravity="center"
        android:textAppearance="@style/NovaPhone.Text.ItemMeta"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_action"
        style="@style/NovaPhone.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_space_xl"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_secondary_action"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_space_xs"
        android:minHeight="@dimen/nova_touch_target"
        android:visibility="gone" />
</LinearLayout>
