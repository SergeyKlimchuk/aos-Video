<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/form_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_phone_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/nova_gutter"
            android:paddingEnd="@dimen/nova_gutter"
            android:paddingBottom="@dimen/nova_space_l">

            <TextView
                style="@style/NovaPhone.FormLabel"
                android:text="@string/phone_protocol" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/form_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/form_protocol_smb"
                    style="@style/NovaPhone.Button.Segment"
                    android:text="@string/phone_protocol_smb" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/form_protocol_ftp"
                    style="@style/NovaPhone.Button.Segment"
                    android:text="@string/phone_protocol_ftp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/form_protocol_sftp"
                    style="@style/NovaPhone.Button.Segment"
                    android:text="@string/phone_protocol_sftp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/NovaPhone.FormLabel"
                android:labelFor="@id/form_name"
                android:text="@string/phone_field_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/form_name_layout"
                style="@style/NovaPhone.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/form_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:hint="@string/phone_field_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/NovaPhone.FormLabel"
                android:labelFor="@id/form_host"
                android:text="@string/phone_field_host" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/form_host_layout"
                style="@style/NovaPhone.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/form_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:hint="@string/phone_field_host_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NovaPhone.FormLabel"
                        android:labelFor="@id/form_user"
                        android:text="@string/phone_field_user" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/form_user_layout"
                        style="@style/NovaPhone.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/form_user"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:autofillHints="username"
                            android:inputType="textNoSuggestions" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/nova_space_m"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NovaPhone.FormLabel"
                        android:labelFor="@id/form_port"
                        android:text="@string/phone_field_port" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/form_port_layout"
                        style="@style/NovaPhone.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/form_port"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/NovaPhone.FormLabel"
                android:labelFor="@id/form_password"
                android:text="@string/phone_field_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/form_password_layout"
                style="@style/NovaPhone.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/form_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:autofillHints="password"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/form_smb_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/NovaPhone.FormLabel"
                    android:labelFor="@id/form_share"
                    android:text="@string/phone_field_share" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/form_share_layout"
                    style="@style/NovaPhone.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconContentDescription="@string/phone_field_share_browse"
                    app:endIconDrawable="@drawable/ic_phone_folder"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/form_share"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:hint="@string/phone_field_share_hint"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/NovaPhone.FormLabel"
                    android:labelFor="@id/form_domain"
                    android:text="@string/phone_field_domain" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/form_domain_layout"
                    style="@style/NovaPhone.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/form_domain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:hint="@string/phone_field_domain_hint"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/form_ftp_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nova_space_l"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/form_ftps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/nova_touch_target"
                    android:text="@string/phone_ftp_secure"
                    android:textAppearance="@style/NovaPhone.Text.FieldLabel" />

                <TextView
                    android:id="@+id/form_ftp_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nova_space_xs"
                    android:drawablePadding="@dimen/nova_space_s"
                    android:text="@string/phone_ftp_plain_warning"
                    android:textAppearance="@style/NovaPhone.Text.ItemMeta"
                    android:textColor="@color/nova_error" />
            </LinearLayout>

            <TextView
                android:id="@+id/form_sftp_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nova_space_l"
                android:textAppearance="@style/NovaPhone.Text.ItemMeta"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <TextView
                style="@style/NovaPhone.FormLabel"
                android:labelFor="@id/form_root_path"
                android:text="@string/phone_field_start_folder" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/form_root_path_layout"
                style="@style/NovaPhone.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/form_root_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:hint="@string/phone_field_start_folder_hint"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/form_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nova_space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/form_status_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/nova_accent"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />

                <ImageView
                    android:id="@+id/form_status_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/form_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/nova_space_s"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/nova_gutter"
        android:paddingTop="@dimen/nova_space_m"
        android:paddingEnd="@dimen/nova_gutter"
        android:paddingBottom="@dimen/nova_space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/form_test"
            style="@style/NovaPhone.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/phone_test" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/form_save"
            style="@style/NovaPhone.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nova_space_m"
            android:layout_weight="1.35"
            android:text="@string/phone_save" />
    </LinearLayout>
</LinearLayout>
