<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/NovaPhone.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="168dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/nova_space_l"
        android:paddingTop="@dimen/nova_space_l"
        android:paddingEnd="@dimen/nova_space_xs"
        android:paddingBottom="@dimen/nova_space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/pinned_tile"
                android:layout_width="@dimen/nova_icon_tile"
                android:layout_height="@dimen/nova_icon_tile"
                android:background="@drawable/bg_nova_tile">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone_folder"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/pinned_menu"
                android:layout_width="@dimen/nova_touch_target"
                android:layout_height="@dimen/nova_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phone_more_actions"
                android:src="@drawable/ic_phone_pin"
                app:tint="@color/nova_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/pinned_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nova_space_l"
            android:layout_marginEnd="@dimen/nova_space_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/NovaPhone.Text.ItemTitle"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/pinned_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/nova_space_m"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@style/NovaPhone.Text.ItemMeta" />

        <TextView
            android:id="@+id/pinned_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/nova_space_m"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/NovaPhone.Text.ItemMeta" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
